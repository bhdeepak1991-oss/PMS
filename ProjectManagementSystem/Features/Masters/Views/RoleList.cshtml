@model IEnumerable<ProjectManagementSystem.Domain.Master.Role>

<div class="row">
    <div class="col-xs-12">
        <div class="form-block marB10">
            <div class="">
                <div class="inner-body noButton">
                    <div class="row">
                        <div class="col-xs-12">
                            <table class="tbl table-responsive tblThBold table-bordered" style="width:100%" id="tblClientTable">
                                <thead>
                                    <tr>
                                        <th>Role Name</th>
                                        <th>Role Code</th>
                                        <th>Status</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var data in Model)
                                    {
                                        <tr>
                                            <td>@data.Name</td>
                                            <td>@data.Code</td>
                                            <td>@data.IsActive</td>
                                            <td>
                                                <a class="btn btn-danger" onclick="fn_delete('@data.Id')">Delete</a>
                                                <a class="btn btn-success" asp-action="Index" asp-controller="Role" asp-route-id="@data.Id">Edit</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>