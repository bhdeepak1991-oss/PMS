@using ProjectManagementSystem.Domain.Master
@model ProjectManagementSystem.Helpers.ResponseHelper<IEnumerable<Department>>

<div class="row">
    <div class="col-xs-12">
        <div class="form-block marB10">
            <div class="">
                <div class="inner-body noButton">
                    <div class="row">
                        <div class="col-xs-12">
                            <table class="tbl table-responsive tblThBold table-bordered" style="width:100%" id="tblClientTable">
                                <thead>
                                    <tr>
                                        <th>Department Name</th>
                                        <th>Department Code</th>
                                        <th>Status</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var data in Model.Model)
                                    {
                                        <tr>
                                            <td>@data.Name</td>
                                            <td>@data.Code</td>
                                            <td>
                                                @if (data.IsActive)
                                                {
                                                    <button class="btn btn-success">Active</button>
                                                }
                                                else
                                                {
                                                    <button class="btn btn-success">In-Active</button>
                                                }
                                            </td>
                                            <td>
                                                <a class="btn btn-danger" onclick="fn_delete('@data.Id')">Delete</a>
                                                <a class="btn btn-success" asp-action="Index" asp-controller="Department" asp-route-deptId="@data.Id">Edit</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function fn_delete(id){
           if(confirm("Are you sure want to delete the records ?")){
                   $.get('/Department/DeleteDepartment',{deptId: id}, function(resp){
                        showToast(resp.message, "success");
                        fn_AddRole();
                   })
           }
        }
</script>